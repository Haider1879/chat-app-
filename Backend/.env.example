PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ring-chat
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Images, audio and avatars are saved to Backend/uploads/ on localhost.
# Required if your backend sends verification or password-reset emails:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
